// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  enrollment_no   String    @unique
  name            String
  email           String    @unique
  phone_no        String    @unique
  gender          String
  college         String?   // New field for college matching
  fake_name       String?   @unique
  is_premium      Boolean   @default(false)
  status          String    @default("ACTIVE") // Can be ACTIVE, BANNED, FROZEN
  isAdmin         Boolean   @default(false)
  created_at      DateTime  @default(now())
  login_otp       String?
  otp_expiry      DateTime?
  averageRating   Float     @default(0)
  ratingCount     Int       @default(0)
  unfreezeAt      DateTime? // <-- NEW: For timed freeze

  // Coin system fields
  totalCoinsEarned          Decimal   @default(0)
  currentCoinsBalance       Decimal   @default(0)
  totalCoinsRedeemed        Decimal   @default(0)
  coinOptInEnabled          Boolean   @default(false)
  coinOptInDate             DateTime?
  referralCode              String?   @unique
  isNewUserBonusApplied     Boolean   @default(false)
  lastLoginDate             DateTime?

  chatrooms       Chatroom[] @relation("ChatroomParticipants")
  hiddenChats     Chatroom[] @relation("HiddenChatsForUsers") // <-- NEW: For soft deleting chats
  sent_messages   Message[]  @relation("SentMessages")
  ratingsGiven    Rating[]   @relation("RatingsGiven")
  ratingsReceived Rating[]   @relation("RatingsReceived")
  blockedUsers    Block[]    @relation("blockedBy")
  blockedBy       Block[]    @relation("blocking")
  reportsMade     Report[]   @relation("reporter")
  reportsAgainst  Report[]   @relation("reported")
  
  // Coin relations
  paymentDetail             UserPaymentDetail?
  coinTransactions          CoinTransaction[]
  redemptionRequests        RedemptionRequest[]
  loginBonusClaims          LoginBonusClaim[]
  referrals                 UserReferral[]    @relation("referrer")
  referredBy                UserReferral[]    @relation("referred")
}

model Chatroom {
  id           String   @id @default(cuid())
  is_private   Boolean  @default(false)
  created_at   DateTime @default(now())
  participants User[]   @relation("ChatroomParticipants")
  hiddenFor    User[]   @relation("HiddenChatsForUsers") // <-- NEW: Tracks users who soft-deleted
  messages     Message[] @relation("ChatroomMessages")
}

model Message {
  id          String   @id @default(cuid())
  content     String
  created_at  DateTime @default(now())
  sender_id   String
  sender      User     @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  chatroom_id String
  chatroom    Chatroom @relation("ChatroomMessages", fields: [chatroom_id], references: [id], onDelete: Cascade)
}

model Rating {
  id        String   @id @default(cuid())
  score     Int?
  review    String?
  createdAt DateTime @default(now())
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId   String
  ratee     User     @relation("RatingsReceived", fields: [rateeId], references: [id], onDelete: Cascade)
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocking", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Report {
  id          String   @id @default(cuid())
  reason      String?
  chatHistory Json
  logType     String   @default("CHAT_LOG") // CHAT_LOG or USER_REPORT
  createdAt   DateTime @default(now())
  reporterId  String?
  reporter    User?    @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedId  String?
  reported    User?    @relation("reported", fields: [reportedId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g., "CONNECT", "DISCONNECT"
  timestamp DateTime @default(now())
}

// ===== COIN SYSTEM MODELS =====

model UserPaymentDetail {
  id              String    @id @default(cuid())
  userId          String    @unique
  paymentMethod   String    // UPI_NUMBER, UPI_ID, BANK_ACCOUNT
  upiNumber       String?
  upiId           String?
  accountNumber   String?
  ifscCode        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoinTransaction {
  id                    String    @id @default(cuid())
  userId                String
  type                  String    // EARNED_CALL, REDEEMED, ADMIN_ADJUSTMENT
  coinsAmount           Decimal
  callDurationSeconds   Int?
  callId                String?
  redemptionRequestId   String?
  isNewUserBonus        Boolean   @default(false)
  isReferralBonus       Boolean   @default(false)
  reason                String?
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RedemptionRequest {
  id                String    @id @default(cuid())
  userId            String
  requestedCoins    Decimal   @default(1000)  // Fixed at 1000 coins
  status            String    // PENDING, APPROVED, REJECTED, TRANSFERRED
  requestDate       DateTime  @default(now())
  approvedDate      DateTime?
  transferDate      DateTime?
  transferRefId     String?
  rejectionReason   String?
  approvedByAdminId String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EarningConfig {
  id                           String    @id @default(cuid())
  isEarningEnabled             Boolean   @default(true)
  disabilityMessage            String?
  femaleCoinsAmount            Int       @default(1)
  femaleConversionTimeSeconds  Int       @default(60)
  maleCoinsAmount              Int       @default(1)
  maleConversionTimeSeconds    Int       @default(120)
  lastUpdatedBy                String?
  updatedAt                    DateTime  @updatedAt
}

model UserReferral {
  id                        String    @id @default(cuid())
  referrerId                String
  referredUserId            String
  referralCode              String    @unique
  createdAt                 DateTime  @default(now())
  referredUserEarnedBonus   Boolean   @default(false)
  referrer                  User      @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred                  User      @relation("referred", fields: [referredUserId], references: [id], onDelete: Cascade)
}

model LoginBonusClaim {
  id              String    @id @default(cuid())
  userId          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  bonusAmount     Int       @default(100) // Number of coins for login bonus
  paymentMethod   String    // UPI_NUMBER, UPI_ID, BANK_ACCOUNT
  upiNumber       String?
  upiId           String?
  accountNumber   String?
  ifscCode        String?
  claimedAt       DateTime  @default(now())
  approvedAt      DateTime?
  rejectionReason String?
  approvedByAdminId String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RegistrationRequest {
  id              String   @id @default(cuid())
  enrollment_no   String
  name            String
  email           String
  phone_no        String
  gender          String
  college         String
  upiId           String?
  idCardPhotoUrl  String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  createdAt       DateTime @default(now())

  @@index([status])
}